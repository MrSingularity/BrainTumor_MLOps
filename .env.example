# =============================================================================
# .env.example — copy to .env and fill in your values
# Never commit the .env file (it is gitignored)
# =============================================================================

# --- Weights & Biases ---
# Get your key at https://wandb.ai/authorize
WANDB_API_KEY=
WANDB_PROJECT=brain-tumor-classification
WANDB_ENTITY=

# --- Kaggle ---
# Get from https://www.kaggle.com/settings -> "Create New API Token"
# This downloads a kaggle.json file containing these two fields
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000

# --- DVC remote (Google Drive) ---
# The remote is configured in .dvc/config. The first `dvc push` / `dvc pull`
# opens an OAuth flow in the browser; the token is cached locally in
# ~/.cache/pydrive2fs/. No env vars are required for the default GDrive setup.
#
# If we later migrate to S3 / MinIO, set the keys below and run:
#   dvc remote modify gdrive url s3://<bucket>/<path>
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-west-1
# AWS_ENDPOINT_URL=         # set only for MinIO / non-AWS S3

# --- Note ---
# Model name, batch size, learning rate, device, and paths live in the Hydra
# configs under `configs/` (see configs/config.yaml). This file is for
# secrets and per-environment infrastructure variables only.
