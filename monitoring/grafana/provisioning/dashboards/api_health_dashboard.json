{
  "title": "API Health",
  "uid": "api-health",
  "schemaVersion": 38,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Requests Per Second",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } } },
      "targets": [{ "datasource": "Prometheus", "expr": "rate(brain_tumor_requests_total[1m])", "legendFormat": "{{status}}" }]
    },
    {
      "id": 2,
      "title": "Error Rate %",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 10 }] } } },
      "targets": [{ "datasource": "Prometheus", "expr": "100 * rate(brain_tumor_requests_total{status='error'}[5m]) / (rate(brain_tumor_requests_total[5m]) + 0.001)", "legendFormat": "Error Rate" }]
    },
    {
      "id": 3,
      "title": "Total Requests",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "blue", "value": null }] } } },
      "targets": [{ "datasource": "Prometheus", "expr": "brain_tumor_requests_total", "legendFormat": "{{status}}" }]
    },
    {
      "id": 4,
      "title": "p50 Latency (ms)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 4, "w": 6, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 500 }, { "color": "red", "value": 1000 }] } } },
      "targets": [{ "datasource": "Prometheus", "expr": "histogram_quantile(0.50, rate(brain_tumor_latency_ms_bucket[5m]))", "legendFormat": "p50" }]
    },
    {
      "id": 5,
      "title": "p95 Latency (ms)",
      "type": "stat",
      "gridPos": { "x": 18, "y": 4, "w": 6, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1000 }, { "color": "red", "value": 2000 }] } } },
      "targets": [{ "datasource": "Prometheus", "expr": "histogram_quantile(0.95, rate(brain_tumor_latency_ms_bucket[5m]))", "legendFormat": "p95" }]
    },
    {
      "id": 6,
      "title": "p50 / p95 / p99 Latency Over Time",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "palette-classic" } } },
      "targets": [
        { "datasource": "Prometheus", "expr": "histogram_quantile(0.50, rate(brain_tumor_latency_ms_bucket[5m]))", "legendFormat": "p50" },
        { "datasource": "Prometheus", "expr": "histogram_quantile(0.95, rate(brain_tumor_latency_ms_bucket[5m]))", "legendFormat": "p95" },
        { "datasource": "Prometheus", "expr": "histogram_quantile(0.99, rate(brain_tumor_latency_ms_bucket[5m]))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 7,
      "title": "Error Rate Over Time",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "color": { "mode": "fixed", "fixedColor": "red" } } },
      "targets": [{ "datasource": "Prometheus", "expr": "rate(brain_tumor_requests_total{status='error'}[5m]) / (rate(brain_tumor_requests_total[5m]) + 0.001)", "legendFormat": "Error Rate" }]
    }
  ]
}
