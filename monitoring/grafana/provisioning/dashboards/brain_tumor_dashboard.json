{
  "title": "Brain Tumor Detection — Overview",
  "uid": "brain-tumor-overview",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Daily Predictions",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "background", "graphMode": "area", "textMode": "auto", "orientation": "auto" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "blue", "value": null }] }, "unit": "short" } },
      "targets": [{ "datasource": "Prometheus", "expr": "increase(brain_tumor_api_predictions_total[24h])", "legendFormat": "Predictions today" }]
    },
    {
      "id": 2,
      "title": "% Positive (Tumor Detected)",
      "type": "gauge",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "minVizWidth": 75, "minVizHeight": 75, "orientation": "auto" },
      "fieldConfig": { "defaults": { "min": 0, "max": 100, "unit": "percent", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 30 }, { "color": "red", "value": 60 }] } } },
      "targets": [{ "datasource": "Prometheus", "expr": "100 * sum(increase(brain_tumor_api_predictions_total{label=\"tumor\"}[24h])) / sum(increase(brain_tumor_api_predictions_total[24h]))", "legendFormat": "% Tumor" }]
    },
    {
      "id": 3,
      "title": "Average Confidence",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["mean"] }, "colorMode": "background", "graphMode": "none", "textMode": "auto", "orientation": "auto" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "green", "value": 0.85 }] } } },
      "targets": [{ "datasource": "Prometheus", "expr": "rate(brain_tumor_api_prediction_confidence_sum[24h]) / rate(brain_tumor_api_prediction_confidence_count[24h])", "legendFormat": "Avg Confidence" }]
    },
    {
      "id": 4,
      "title": "Drift Status",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value_and_name", "orientation": "auto" },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "range", "options": { "from": 0, "to": 0.3, "result": { "text": "OK", "color": "green" } } }, { "type": "range", "options": { "from": 0.3, "to": 0.6, "result": { "text": "WATCH", "color": "yellow" } } }, { "type": "range", "options": { "from": 0.6, "to": 1, "result": { "text": "DRIFT", "color": "red" } } }], "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.3 }, { "color": "red", "value": 0.6 }] } } },
      "targets": [{ "datasource": "Prometheus", "expr": "sum(increase(brain_tumor_api_predictions_total{label=\"tumor\"}[24h])) / sum(increase(brain_tumor_api_predictions_total[24h]))", "legendFormat": "Positive Rate" }]
    },
    {
      "id": 5,
      "title": "Predictions Over Time",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } },
      "targets": [
        { "datasource": "Prometheus", "expr": "increase(brain_tumor_api_predictions_total{label=\"tumor\"}[1h])", "legendFormat": "Tumor" },
        { "datasource": "Prometheus", "expr": "increase(brain_tumor_api_predictions_total{label=\"no_tumor\"}[1h])", "legendFormat": "No Tumor" }
      ]
    },
    {
      "id": 6,
      "title": "Average Latency (ms)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "single" } },
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "fixed", "fixedColor": "blue" } } },
      "targets": [{ "datasource": "Prometheus", "expr": "rate(brain_tumor_api_inference_latency_seconds_sum[5m]) / rate(brain_tumor_api_inference_latency_seconds_count[5m])", "legendFormat": "Avg Latency" }]
    }
  ]
}
