{
  "title": "Model Behaviour & Drift",
  "uid": "model-behaviour",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Class Distribution (Tumor vs No Tumor)",
      "type": "piechart",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "options": { "pieType": "pie", "displayLabels": ["name", "percent"] },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } } },
      "targets": [{ "datasource": "Prometheus", "expr": "brain_tumor_api_predictions_total", "legendFormat": "{{label}}" }]
    },
    {
      "id": 2,
      "title": "Positive Rate (Drift Indicator)",
      "type": "gauge",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto" },
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "unit": "percentunit", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.3 }, { "color": "red", "value": 0.6 }] } } },
      "targets": [{ "datasource": "Prometheus", "expr": "sum(brain_tumor_api_predictions_total{label='tumor'}) / (sum(brain_tumor_api_predictions_total) + 0.001)", "legendFormat": "Positive Rate" }]
    },
    {
      "id": 3,
      "title": "Confidence Distribution",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "color": { "mode": "palette-classic" } } },
      "targets": [
        { "datasource": "Prometheus", "expr": "histogram_quantile(0.50, rate(brain_tumor_api_prediction_confidence_bucket[5m]))", "legendFormat": "p50 confidence" },
        { "datasource": "Prometheus", "expr": "histogram_quantile(0.95, rate(brain_tumor_api_prediction_confidence_bucket[5m]))", "legendFormat": "p95 confidence" }
      ]
    },
    {
      "id": 4,
      "title": "Prediction Volume Over Time",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } },
      "targets": [
        { "datasource": "Prometheus", "expr": "rate(brain_tumor_api_predictions_total{label='tumor'}[5m])", "legendFormat": "Tumor" },
        { "datasource": "Prometheus", "expr": "rate(brain_tumor_api_predictions_total{label='no_tumor'}[5m])", "legendFormat": "No Tumor" }
      ]
    },
    {
      "id": 5,
      "title": "Drift Status Over Time",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.3 }, { "color": "red", "value": 0.6 }] }, "custom": { "thresholdsStyle": { "mode": "area" } } } },
      "targets": [{ "datasource": "Prometheus", "expr": "sum(rate(brain_tumor_api_predictions_total{label='tumor'}[1h])) / (sum(rate(brain_tumor_api_predictions_total[1h])) + 0.001)", "legendFormat": "Positive Rate (drift indicator)" }]
    },
    {
      "id": 6,
      "title": "Average Confidence Over Time",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "color": { "mode": "fixed", "fixedColor": "blue" } } },
      "targets": [{ "datasource": "Prometheus", "expr": "rate(brain_tumor_api_prediction_confidence_sum[5m]) / rate(brain_tumor_api_prediction_confidence_count[5m])", "legendFormat": "Avg Confidence" }]
    }
  ]
}
